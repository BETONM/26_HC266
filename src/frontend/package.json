{
  "name": "chembot-lab-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@visx/axis": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "d3-force": "^3.0.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.88.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
