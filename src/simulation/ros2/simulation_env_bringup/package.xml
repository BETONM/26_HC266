<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>simulation_env_bringup</name>
  <version>0.1.0</version>
  <description>
    Gazebo bring-up for the chemistry lab bench: 1 m linear rail with a
    prismatic carriage, two OpenMANIPULATOR-X mounts, and the bench props
    (waste bucket, beakers, cylinder holders, reagent bottles).
  </description>
  <maintainer email="2026trailer@gmail.com">armchemist</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
