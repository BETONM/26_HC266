<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:cb="https://example.org/chembot/ontology#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#Product">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Product</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/chembot/ontology#ChemicalEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#hasCitation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/chembot/ontology#EvidenceSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">hasCitation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#HazardScenario">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">HazardScenario</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#exp_iodate_bisulfite_starch">
    <rdf:type rdf:resource="https://example.org/chembot/ontology#ExperimentDetail"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="ko">요오드산 칼륨 첨가량에 따른 녹말–아황산수소염 색 변화</rdfs:label>
    <cb:hasExperimentName>요오드산 칼륨 첨가량에 따른 녹말–아황산수소염 색 변화</cb:hasExperimentName>
    <cb:hasGoal rdf:resource="https://example.org/chembot/ontology#goal_color_change"/>
    <cb:belongsToCategory rdf:resource="https://example.org/chembot/ontology#category_StarchIndicator"/>
    <cb:belongsToCategory rdf:resource="https://example.org/chembot/ontology#category_RedoxReaction"/>
    <cb:hasPrecursorRequirement rdf:resource="https://example.org/chembot/ontology#requirement_iodate"/>
    <cb:hasPrecursorRequirement rdf:resource="https://example.org/chembot/ontology#requirement_bisulfite"/>
    <cb:hasPrecursorRequirement rdf:resource="https://example.org/chembot/ontology#requirement_starch"/>
    <cb:hasProcedure rdf:resource="https://example.org/chembot/ontology#procedure_main"/>
    <cb:hasExpectedResult rdf:resource="https://example.org/chembot/ontology#expected_blue"/>
    <cb:requiresEquipment rdf:resource="https://example.org/chembot/ontology#equipment_beaker"/>
    <cb:requiresEquipment rdf:resource="https://example.org/chembot/ontology#equipment_camera"/>
    <cb:requiresEquipment rdf:resource="https://example.org/chembot/ontology#equipment_conductivity"/>
    <cb:requiresEquipment rdf:resource="https://example.org/chembot/ontology#equipment_ph"/>
    <cb:requiresEquipment rdf:resource="https://example.org/chembot/ontology#equipment_temperature"/>
    <cb:hasHazardScenario rdf:resource="https://example.org/chembot/ontology#scenario_acid_bisulfite"/>
    <cb:hasHazardScenario rdf:resource="https://example.org/chembot/ontology#scenario_iodate_combustible"/>
    <cb:hasHazardScenario rdf:resource="https://example.org/chembot/ontology#scenario_dispensing_splash"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#hazard_so2">
    <rdf:type rdf:resource="https://example.org/chembot/ontology#Hazard"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="ko">산 접촉 시 이산화황 발생 가능성</rdfs:label>
    <cb:hasHazardDescription>아황산수소나트륨이 산성 물질과 접촉하면 이산화황(SO2)이 방출될 수 있다.</cb:hasHazardDescription>
    <cb:hasEvidenceStatus>chemical_hazard_general</cb:hasEvidenceStatus>
    <cb:hasHazardFactor rdf:resource="https://example.org/chembot/ontology#factor_acid_contact"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#hasPhenomenon">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/chembot/ontology#ExperimentDetail"/>
    <rdfs:range rdf:resource="https://example.org/chembot/ontology#ReactionPhenomenon"/>
    <rdfs:label xml:lang="en">hasPhenomenon</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#ReactionStep">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">ReactionStep</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#ExperimentGoal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">ExperimentGoal</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#condition_acid_contact">
    <rdf:type rdf:resource="https://example.org/chembot/ontology#Condition"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="ko">산성 물질과의 접촉</rdfs:label>
    <cb:hasConditionDescription>아황산수소나트륨이 별도의 산성 물질과 접촉하는 조건. 본 실험에서 실제로 발생했다고 가정하지 않는다.</cb:hasConditionDescription>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#procedure_main">
    <rdf:type rdf:resource="https://example.org/chembot/ontology#Procedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="ko">녹말-아이오딘 색 변화 관찰 절차</rdfs:label>
    <cb:hasProcedureDescription xml:lang="ko">시약 식별 및 안전 정보 확인 → 실험 조건 설정 → 시약 혼합 → 색 변화 관찰 및 기록. 구체적인 분주량과 로봇 제어는 승인된 실험 절차에서 별도 설정한다.</cb:hasProcedureDescription>
    <cb:hasProcedureStep rdf:resource="https://example.org/chembot/ontology#step_prepare"/>
    <cb:hasProcedureStep rdf:resource="https://example.org/chembot/ontology#step_dispense"/>
    <cb:hasProcedureStep rdf:resource="https://example.org/chembot/ontology#step_observe"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#hasGoalName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/chembot/ontology#ExperimentGoal"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">hasGoalName</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#hasPrecursorRequirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/chembot/ontology#ExperimentDetail"/>
    <rdfs:range rdf:resource="https://example.org/chembot/ontology#PrecursorRequirement"/>
    <rdfs:label xml:lang="en">hasPrecursorRequirement</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#hasQuantity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/chembot/ontology#PrecursorRequirement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">hasQuantity</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#hasStepNumber">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/chembot/ontology#ProcedureStep"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">hasStepNumber</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#hasSMILES">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/chembot/ontology#ChemicalEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">hasSMILES</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#requirement_bisulfite">
    <rdf:type rdf:resource="https://example.org/chembot/ontology#PrecursorRequirement"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="ko">sodium_bisulfite 요구량</rdfs:label>
    <cb:hasRole>반응물</cb:hasRole>
    <cb:requiresPrecursor rdf:resource="https://example.org/chembot/ontology#chemical_sodium_bisulfite"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#category_StarchIndicator">
    <rdf:type rdf:resource="https://example.org/chembot/ontology#ExperimentCategory"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="ko">녹말 지시약 실험</rdfs:label>
    <cb:hasCategoryName>녹말 지시약 실험</cb:hasCategoryName>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#category_MetalIonColorChange">
    <rdf:type rdf:resource="https://example.org/chembot/ontology#ExperimentCategory"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="ko">금속 이온 색 변화</rdfs:label>
    <cb:hasCategoryName>금속 이온 색 변화</cb:hasCategoryName>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#hasRecordedAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/chembot/ontology#ExperimentRun"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">hasRecordedAt</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#chemical_bisulfite_ion">
    <rdf:type rdf:resource="https://example.org/chembot/ontology#ChemicalEntity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="ko">아황산수소 이온</rdfs:label>
    <cb:hasChemicalFormula>HSO3-</cb:hasChemicalFormula>
    <cb:hasSMILES>O=S([O-])O</cb:hasSMILES>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#scenario_dispensing_splash">
    <rdf:type rdf:resource="https://example.org/chembot/ontology#HazardScenario"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="ko">시약 분주·혼합 시 비산 노출</rdfs:label>
    <cb:hasTriggerDescription>분주·혼합 과정에서 액적이 튀는 경우의 노출 위험</cb:hasTriggerDescription>
    <cb:hasEvidenceStatus>conditional_preexperiment_hazard</cb:hasEvidenceStatus>
    <cb:hasHazard rdf:resource="https://example.org/chembot/ontology#hazard_irritation"/>
    <cb:triggeredUnder rdf:resource="https://example.org/chembot/ontology#conditions_splash"/>
    <cb:hasSafetyConstraint rdf:resource="https://example.org/chembot/ontology#constraint_splash_protection"/>
    <cb:involvesChemical rdf:resource="https://example.org/chembot/ontology#chemical_potassium_iodate"/>
    <cb:involvesChemical rdf:resource="https://example.org/chembot/ontology#chemical_sodium_bisulfite"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#scenario_iodate_combustible">
    <rdf:type rdf:resource="https://example.org/chembot/ontology#HazardScenario"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="ko">요오드산 칼륨의 가연물 접촉</rdfs:label>
    <cb:hasTriggerDescription>산화성 시약의 보관 및 준비 단계에서 부적절한 가연물 접촉 위험</cb:hasTriggerDescription>
    <cb:hasEvidenceStatus>conditional_preexperiment_hazard</cb:hasEvidenceStatus>
    <cb:hasHazard rdf:resource="https://example.org/chembot/ontology#hazard_oxidizer"/>
    <cb:triggeredUnder rdf:resource="https://example.org/chembot/ontology#conditions_combustible_contact"/>
    <cb:hasSafetyConstraint rdf:resource="https://example.org/chembot/ontology#constraint_segregate_oxidizer"/>
    <cb:involvesChemical rdf:resource="https://example.org/chembot/ontology#chemical_potassium_iodate"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#reactionUses">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/chembot/ontology#ReactionStep"/>
    <rdfs:range rdf:resource="https://example.org/chembot/ontology#ChemicalEntity"/>
    <rdfs:label xml:lang="en">reactionUses</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#scenario_acid_bisulfite">
    <rdf:type rdf:resource="https://example.org/chembot/ontology#HazardScenario"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="ko">아황산수소나트륨의 산 접촉 시 SO2 방출</rdfs:label>
    <cb:hasTriggerDescription>별도의 산성 물질과 접촉할 경우에 해당하는 조건부 위험</cb:hasTriggerDescription>
    <cb:hasEvidenceStatus>conditional_preexperiment_hazard</cb:hasEvidenceStatus>
    <cb:hasHazard rdf:resource="https://example.org/chembot/ontology#hazard_so2"/>
    <cb:triggeredUnder rdf:resource="https://example.org/chembot/ontology#conditions_acid_contact"/>
    <cb:hasSafetyConstraint rdf:resource="https://example.org/chembot/ontology#constraint_avoid_acids"/>
    <cb:involvesChemical rdf:resource="https://example.org/chembot/ontology#chemical_sodium_bisulfite"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#hasOutcome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/chembot/ontology#ExperimentRun"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">hasOutcome</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#hasHazardScenarioAtStep">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasHazardScenarioAtStep</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/chembot/ontology#ProcedureStep"/>
    <rdfs:range rdf:resource="https://example.org/chembot/ontology#HazardScenario"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#hasProductName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/chembot/ontology#Product"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">hasProductName</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#hasObservation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/chembot/ontology#ObservedResult"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">hasObservation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#chemical_potassium_iodate">
    <rdf:type rdf:resource="https://example.org/chembot/ontology#Precursor"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="ko">요오드산 칼륨</rdfs:label>
    <cb:hasChemicalFormula>KIO3</cb:hasChemicalFormula>
    <cb:hasCAS>7758-05-6</cb:hasCAS>
    <cb:hasSMILES>[K+].[O-][I+2]([O-])[O-]</cb:hasSMILES>
    <cb:hasHazard rdf:resource="https://example.org/chembot/ontology#hazard_oxidizer"/>
    <cb:hasHazard rdf:resource="https://example.org/chembot/ontology#hazard_irritation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#step_dispense">
    <rdf:type rdf:resource="https://example.org/chembot/ontology#ProcedureStep"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="ko">시약 분주 및 혼합</rdfs:label>
    <cb:hasStepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cb:hasStepOrder>
    <cb:hasHazardScenarioAtStep rdf:resource="https://example.org/chembot/ontology#scenario_dispensing_splash"/>
    <cb:hasHazardAtStep rdf:resource="https://example.org/chembot/ontology#hazard_irritation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#involvesChemical">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/chembot/ontology#HazardScenario"/>
    <rdfs:range rdf:resource="https://example.org/chembot/ontology#ChemicalEntity"/>
    <rdfs:label xml:lang="en">involvesChemical</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#condition_splash">
    <rdf:type rdf:resource="https://example.org/chembot/ontology#Condition"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="ko">분주·혼합 중 비산</rdfs:label>
    <cb:hasConditionDescription>액체 시약 분주 또는 혼합 과정에서 액적이 튀는 조건</cb:hasConditionDescription>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#event_skin_eye_contact">
    <rdf:type rdf:resource="https://example.org/chembot/ontology#HazardEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="ko">시약의 눈·피부 접촉</rdfs:label>
    <cb:hasRiskConsequence rdf:resource="https://example.org/chembot/ontology#consequence_irritation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#hasRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/chembot/ontology#PrecursorRequirement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">hasRole</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#hasGHSCode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/chembot/ontology#Hazard"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">hasGHSCode</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#hasEquation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/chembot/ontology#ReactionStep"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">hasEquation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#producesProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/chembot/ontology#ExperimentDetail"/>
    <rdfs:range rdf:resource="https://example.org/chembot/ontology#Product"/>
    <rdfs:label xml:lang="en">producesProduct</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/chembot/ontology#chemical_iodide_ion">
    <rdf:type rdf:resource="https://example.org/chembot/ontology#Product"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="ko">요오드화 이온</rdfs:label>
    <cb:hasChemicalFormula>I-</cb:hasChemicalFormula>
    <cb:hasSMILES>[I-]</cb:hasSMILES>
    <cb:hasProductName>요오드화 이온</cb:hasProductName>
